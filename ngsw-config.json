{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.json",
          "/styles*.css",
          "/polyfills-*.js",
          "/main-*.js"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-assets",
      "urls": [
        "/api/assets/**",
        "/api/asset/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "1h",
        "maxSize": 20
      }
    },
    {
      "name": "api-tickets",
      "urls": [
        "/api/tickets/**",
        "/api/ticket/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "30m",
        "maxSize": 50
      }
    },
    {
      "name": "api-employees",
      "urls": [
        "/api/employees/**",
        "/api/employee/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxAge": "24h",
        "maxSize": 30
      }
    },
    {
      "name": "api-dashboard",
      "urls": [
        "/api/dashboard/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxAge": "10m",
        "maxSize": 5
      }
    },
    {
      "name": "api-auth",
      "urls": [
        "/auth/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeoutMs": 5000
      }
    },
    {
      "name": "api-other",
      "urls": [
        "/api/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeoutMs": 5000
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*"
  ]
}
